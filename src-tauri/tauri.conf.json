{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DRG Runtime Trainer",
  "version": "0.1.0",
  "identifier": "local.drg.credits",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DRG Runtime Trainer",
        "width": 940,
        "height": 660,
        "minWidth": 760,
        "minHeight": 590,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "backgroundColor": "#0c0f0d"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
